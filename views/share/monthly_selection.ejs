<%
  const photoUrl = (player) => {
    if (player?.photoDataUri) return player.photoDataUri;
    if (!player?.photoUrl) return baseUrl + '/img/logo-128x128.svg';
    if (/^data:image\//i.test(player.photoUrl)) return player.photoUrl;
    if (/^https?:\/\//i.test(player.photoUrl)) return player.photoUrl;
    return baseUrl + '/' + String(player.photoUrl).replace(/^\/+/, '');
  };
  const logoMarkSrc = typeof logoMarkUrl !== 'undefined' && logoMarkUrl ? logoMarkUrl : baseUrl + '/img/logo-128x128.svg';
  const logoIconSrc = typeof logoIconUrl !== 'undefined' && logoIconUrl ? logoIconUrl : baseUrl + '/img/logo-32x32.svg';
  const safeBrand = typeof brand !== 'undefined' && brand ? brand : {
    name: 'Horriver Plate',
    url: 'horriverplate.onrender.com',
  };
  const displayName = (player) => player?.nickname || player?.name || '-';
  const initialOf = (player) => displayName(player).charAt(0).toUpperCase() || '?';
  const groups = Array.isArray(typeof selectionGroups !== 'undefined' ? selectionGroups : null) ? selectionGroups : [];
  const selectionRows = ['ATA', 'MEI', 'ZAG', 'GOL'].map(key => {
    const group = groups.find(item => item.key === key);
    return { key, players: group && Array.isArray(group.players) ? group.players : [] };
  }).filter(row => row.players.length);
  const fieldBackgroundSrc = typeof selectionFieldUrl !== 'undefined' && selectionFieldUrl
    ? selectionFieldUrl
    : baseUrl + '/img/weekly-selection-field.jpg';
  const votesLabel = (n) => n + (Number(n) === 1 ? ' voto' : ' votos');
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=720" />
  <title>Seleção do Mês</title>
  <style>
    <%- typeof fontCss !== "undefined" ? fontCss : "" %>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 720px;
      min-width: 720px;
      background: transparent;
      display: inline-block;
      line-height: 0;
      -webkit-font-smoothing: antialiased;
      text-rendering: geometricPrecision;
    }

    /* ── Card ── */
    .vrc-card {
      position: relative;
      width: 720px;
      border-radius: 34px;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 10%, rgba(139, 19, 32,0.26) 0%, transparent 38%),
        radial-gradient(circle at 86% 86%, rgba(255, 122, 26,0.10) 0%, transparent 34%),
        radial-gradient(circle at 50% 100%, rgba(139, 19, 32,0.14) 0%, transparent 36%),
        linear-gradient(155deg, #1e0509 0%, #0d0210 52%, #050509 100%);
      border: 1px solid rgba(255, 122, 26,0.22);
      box-shadow: 0 18px 42px rgba(0,0,0,0.34);
      font-family: 'Manrope', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
      text-rendering: geometricPrecision;
    }

    /* ── Watermark ── */
    .vrc-watermark {
      position: absolute;
      left: 50%; top: 42%;
      transform: translate(-50%, -50%);
      width: 380px; height: 380px;
      opacity: 0.03;
      pointer-events: none;
      user-select: none;
    }

    /* ── Inner ── */
    .vrc-inner {
      position: relative;
      z-index: 1;
      padding: 34px 34px 38px;
    }

    /* ── Branding ── */
    .vrc-branding {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 26px;
    }
    .vrc-logo { width: 32px; height: 32px; opacity: 0.85; }
    .vrc-brand-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 20px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: #ffb36a;
      line-height: 1;
    }

    /* ── Title row ── */
    .vrc-title-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 28px;
    }
    .vrc-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 58px;
      line-height: 0.94;
      color: #f5f5f5;
      letter-spacing: 0.02em;
    }
    .vrc-title-meta {
      text-align: right;
      padding-bottom: 6px;
      flex-shrink: 0;
    }
    .vrc-title-meta-label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.20em;
      color: rgba(178,184,194,0.52);
      line-height: 1;
      margin-bottom: 6px;
    }
    .vrc-title-meta-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 22px;
      color: #f5f5f5;
      line-height: 1;
      margin-bottom: 5px;
    }
    .vrc-title-meta-date {
      font-size: 13px;
      font-weight: 600;
      color: #ff7a1a;
      line-height: 1;
    }

    /* ── Dividers ── */
    .vrc-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 122, 26,0.62), transparent);
      margin-bottom: 24px;
    }
    .vrc-divider--subtle {
      height: 1px;
      background: rgba(255,255,255,0.06);
      margin-bottom: 22px;
    }

    /* ── Section label ── */
    .vrc-section-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.26em;
      color: rgba(178,184,194,0.50);
      line-height: 1;
      margin-bottom: 16px;
    }

    /* ── Craque block ── */
    .vrc-craque {
      display: flex;
      align-items: center;
      gap: 22px;
      margin-bottom: 28px;
    }
    .vrc-craque-photo {
      width: 110px; height: 110px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      border: 3px solid rgba(255, 122, 26,0.85);
      box-shadow: 0 0 28px rgba(255, 122, 26,0.28);
      background: #111;
    }
    .vrc-craque-photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .vrc-craque-photo-fallback {
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 122, 26,0.10);
      font-family: 'Bebas Neue', sans-serif;
      font-size: 48px;
      color: #ff7a1a;
      line-height: 1;
    }
    .vrc-craque-info { flex: 1; min-width: 0; }
    .vrc-craque-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 54px;
      line-height: 0.92;
      color: #f5f5f5;
      word-break: break-word;
      margin-bottom: 8px;
    }
    .vrc-craque-position {
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.20em;
      color: rgba(178,184,194,0.60);
      line-height: 1;
    }
    .vrc-craque-score-box {
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 16px 20px;
      border-radius: 20px;
      border: 1px solid rgba(255, 122, 26,0.30);
      background: rgba(255, 122, 26,0.06);
    }
    .vrc-craque-score-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.26em;
      color: rgba(255,179,106,0.72);
      line-height: 1;
    }
    .vrc-craque-score-line {
      display: block;
      width: 40px; height: 3px;
      border-radius: 999px;
      background: linear-gradient(90deg, #8b1320, #ff7a1a);
    }
    .vrc-craque-score-value {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 56px;
      line-height: 0.88;
      color: #ff7a1a;
    }

    /* ── Mini photo (shared by highlights + top5) ── */
    .vrc-mini-photo {
      width: 44px; height: 44px;
      border-radius: 50%;
      overflow: hidden;
      flex-shrink: 0;
      border: 1.5px solid rgba(255, 122, 26,0.40);
      background: #111;
    }
    .vrc-mini-photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    .vrc-mini-photo-fallback {
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 122, 26,0.10);
      font-family: 'Bebas Neue', sans-serif;
      font-size: 18px;
      color: #ff7a1a;
      line-height: 1;
    }

    /* ── Highlights rows ── */
    .vrc-highlights { margin-bottom: 28px; }
    .vrc-highlight-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .vrc-highlight-row:last-child { border-bottom: none; }
    .vrc-highlight-abbr {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 18px;
      letter-spacing: 0.10em;
      color: rgba(255, 122, 26,0.72);
      width: 44px;
      flex-shrink: 0;
      line-height: 1;
    }
    .vrc-highlight-name {
      flex: 1;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 28px;
      color: #f5f5f5;
      line-height: 1;
      letter-spacing: 0.02em;
    }
    .vrc-highlight-score {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 28px;
      color: #ff7a1a;
      line-height: 1;
      flex-shrink: 0;
      min-width: 56px;
      text-align: right;
    }

    /* ── Top 5 rows ── */
    .vrc-top5 { margin-bottom: 24px; }
    .vrc-top5-row {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .vrc-top5-row:last-child { border-bottom: none; }
    .vrc-top5-rank {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 22px;
      color: rgba(255, 122, 26,0.52);
      width: 28px;
      flex-shrink: 0;
      text-align: center;
      line-height: 1;
    }
    .vrc-top5-rank--gold   { color: #f5c542; }
    .vrc-top5-rank--silver { color: rgba(210,210,220,0.70); }
    .vrc-top5-info {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .vrc-top5-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 28px;
      color: #f5f5f5;
      line-height: 1;
      letter-spacing: 0.02em;
    }
    .vrc-top5-pos {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(178,184,194,0.52);
      line-height: 1;
    }
    .vrc-top5-score {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 28px;
      color: #f5f5f5;
      flex-shrink: 0;
      min-width: 56px;
      text-align: right;
      line-height: 1;
    }
    .vrc-top5-score--gold { color: #f5c542; }

    /* ── Seleção da semana ── */
    .vrc-selection { margin-bottom: 24px; }
    .vrc-field {
      position: relative;
      overflow: hidden;
      height: 560px;
      border-radius: 28px;
      border: 1px solid rgba(255, 122, 26,0.22);
      background:
        linear-gradient(180deg, rgba(30, 5, 9,0.10), rgba(0,0,0,0.24)),
        url("<%= fieldBackgroundSrc %>") center center / cover no-repeat;
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,0.035),
        inset 0 -80px 110px rgba(0,0,0,0.42);
    }
    .vrc-field::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 52%, rgba(255, 122, 26,0.10), transparent 34%),
        linear-gradient(180deg, rgba(0,0,0,0.14), transparent 24%, transparent 70%, rgba(0,0,0,0.32));
      pointer-events: none;
    }
    .vrc-field-row {
      position: absolute;
      left: 34px;
      right: 34px;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 96px;
      min-height: 112px;
    }
    .vrc-field-row--ATA { top: 42px; }
    .vrc-field-row--MEI { top: 188px; }
    .vrc-field-row--ZAG { top: 372px; }
    .vrc-field-row--GOL {
      top: 414px;
      min-height: 132px;
    }
    .vrc-field-pos {
      display: none;
    }
    .vrc-field-player {
      width: 150px;
      min-height: 116px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 7px;
      text-align: center;
      filter: drop-shadow(0 10px 18px rgba(0,0,0,0.36));
    }
    .vrc-field-row--ATA .vrc-field-player {
      transform: scale(0.92);
    }
    .vrc-field-row--MEI .vrc-field-player {
      transform: scale(1);
    }
    .vrc-field-row--ZAG .vrc-field-player {
      transform: scale(1.03);
    }
    .vrc-field-row--GOL .vrc-field-player {
      transform: scale(1.03);
    }
    .vrc-field-photo {
      width: 82px;
      height: 82px;
      overflow: hidden;
      border-radius: 50%;
      border: 2px solid rgba(255, 122, 26,0.70);
      background: rgba(0,0,0,0.62);
      box-shadow: 0 8px 18px rgba(0,0,0,0.28);
    }
    .vrc-field-photo img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }
    .vrc-field-photo-fallback {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ff7a1a;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 24px;
      line-height: 1;
      background: rgba(255, 122, 26,0.10);
    }
    .vrc-field-name {
      width: 100%;
      color: #f5f5f5;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.08;
      overflow-wrap: anywhere;
      text-shadow: 0 2px 8px rgba(0,0,0,0.88);
    }
    .vrc-field-score {
      color: rgba(255, 122, 26,0.82);
      font-size: 11px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    }

    /* ── Footer ── */
    .vrc-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.06);
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: rgba(178,184,194,0.26);
    }
  </style>
</head>
<body>
  <div class="vrc-card">

    <img class="vrc-watermark" src="<%= logoMarkSrc %>" alt="" />

    <div class="vrc-inner">

      <!-- Branding -->
      <div class="vrc-branding">
        <img class="vrc-logo" src="<%= logoIconSrc %>" alt="" />
        <span class="vrc-brand-name"><%= safeBrand.name || "Horriver Plate" %></span>
      </div>

      <!-- Título + mês -->
      <div class="vrc-title-row">
        <h1 class="vrc-title">Seleção<br>do Mês</h1>
        <div class="vrc-title-meta">
          <p class="vrc-title-meta-label">Votação dos jogadores</p>
          <p class="vrc-title-meta-name"><%= monthLabel %></p>
          <p class="vrc-title-meta-date"><%= voters %> <%= Number(voters) === 1 ? 'votante' : 'votantes' %></p>
        </div>
      </div>

      <div class="vrc-divider"></div>

      <!-- Seleção do mês -->
      <div class="vrc-selection">
        <div class="vrc-field">
          <% selectionRows.forEach(function(row) { %>
            <div class="vrc-field-row vrc-field-row--<%= row.key %>">
              <% row.players.forEach(function(candidate) { %>
                <div class="vrc-field-player">
                  <div class="vrc-field-photo">
                    <% if (candidate?.photoUrl || candidate?.photoDataUri) { %>
                      <img src="<%= photoUrl(candidate) %>" alt="" />
                    <% } else { %>
                      <div class="vrc-field-photo-fallback"><%= initialOf(candidate) %></div>
                    <% } %>
                  </div>
                  <span class="vrc-field-name"><%= displayName(candidate) %></span>
                  <span class="vrc-field-score"><%= votesLabel(candidate.votes || 0) %></span>
                </div>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Footer -->
      <div class="vrc-footer">
        <span><%= safeBrand.url || "horriverplate.onrender.com" %></span>
        <span>@_hpfrc</span>
      </div>

    </div>
  </div>
</body>
</html>
