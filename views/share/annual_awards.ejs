<%
  const photoUrl = (player) => {
    if (player?.photoDataUri) return player.photoDataUri;
    if (!player?.photoUrl) return baseUrl + '/img/logo-128x128.svg';
    if (/^data:image\//i.test(player.photoUrl)) return player.photoUrl;
    if (/^https?:\/\//i.test(player.photoUrl)) return player.photoUrl;
    return baseUrl + '/' + String(player.photoUrl).replace(/^\/+/, '');
  };
  const hasPhoto = (player) => !!(player?.photoDataUri || player?.photoUrl);
  const safeBrand = typeof brand !== 'undefined' && brand ? brand : {
    name: 'Horriver Plate',
    url: 'horriverplate.onrender.com',
  };
  const displayName = (player) => player?.nickname || player?.name || '-';
  const initialOf = (player) => displayName(player).charAt(0).toUpperCase() || '?';
  const selectionRows = ['ATA', 'MEI', 'ZAG', 'GOL'].map((key) => {
    const group = selectionGroups.find((item) => item.key === key);
    return { key, players: group ? group.players : [] };
  }).filter((row) => row.players.length);
  const votesLabel = (n) => n + (Number(n) === 1 ? ' voto' : ' votos');
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=720" />
  <title>Melhores do Ano <%= year %></title>
  <style>
    <%- typeof fontCss !== "undefined" ? fontCss : "" %>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 720px;
      min-width: 720px;
      background: transparent;
      display: inline-block;
      line-height: 0;
      -webkit-font-smoothing: antialiased;
      text-rendering: geometricPrecision;
    }

    /* ── Card ── */
    .vrc-card {
      position: relative;
      width: 720px;
      border-radius: 34px;
      overflow: hidden;
      background:
        radial-gradient(circle at 12% 10%, rgba(139, 19, 32,0.26) 0%, transparent 38%),
        radial-gradient(circle at 86% 86%, rgba(255, 122, 26,0.10) 0%, transparent 34%),
        radial-gradient(circle at 50% 100%, rgba(139, 19, 32,0.14) 0%, transparent 36%),
        linear-gradient(155deg, #1e0509 0%, #0d0210 52%, #050509 100%);
      border: 1px solid rgba(255, 122, 26,0.22);
      box-shadow: 0 18px 42px rgba(0,0,0,0.34);
      font-family: 'Manrope', system-ui, sans-serif;
    }
    .vrc-watermark {
      position: absolute;
      left: 50%; top: 42%;
      transform: translate(-50%, -50%);
      width: 380px; height: 380px;
      opacity: 0.03;
      pointer-events: none;
    }
    .vrc-inner {
      position: relative;
      z-index: 1;
      padding: 34px 34px 38px;
    }

    /* ── Branding ── */
    .vrc-branding {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 26px;
    }
    .vrc-logo { width: 32px; height: 32px; opacity: 0.85; }
    .vrc-brand-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 20px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      color: #ffb36a;
      line-height: 1;
    }

    /* ── Título ── */
    .vrc-title-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 26px;
    }
    .vrc-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 58px;
      line-height: 0.94;
      color: #f5f5f5;
      letter-spacing: 0.02em;
    }
    .vrc-title-meta { text-align: right; padding-bottom: 6px; flex-shrink: 0; }
    .vrc-title-meta-label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.20em;
      color: rgba(178,184,194,0.52);
      line-height: 1;
      margin-bottom: 6px;
    }
    .vrc-title-meta-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 34px;
      color: #f5f5f5;
      line-height: 1;
      margin-bottom: 5px;
    }
    .vrc-title-meta-date {
      font-size: 13px;
      font-weight: 600;
      color: #ff7a1a;
      line-height: 1;
    }
    .vrc-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255, 122, 26,0.62), transparent);
      margin-bottom: 24px;
    }
    .vrc-section-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.26em;
      color: rgba(255,179,106,0.72);
      line-height: 1;
      margin-bottom: 14px;
    }

    /* ── Melhor do ano ── */
    .vrc-best {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-bottom: 18px;
    }
    .vrc-best-photo {
      width: 132px; height: 172px;
      border-radius: 24px;
      overflow: hidden;
      flex-shrink: 0;
      border: 3px solid rgba(255, 122, 26,0.85);
      box-shadow: 0 0 36px rgba(255, 122, 26,0.30);
      background: #111;
    }
    .vrc-best-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .vrc-photo-fallback {
      width: 100%; height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 122, 26,0.10);
      font-family: 'Bebas Neue', sans-serif;
      font-size: 48px;
      color: #ff7a1a;
      line-height: 1;
    }
    .vrc-best-info { flex: 1; min-width: 0; }
    .vrc-best-label {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.26em;
      color: rgba(255,179,106,0.72);
      line-height: 1;
      margin-bottom: 10px;
    }
    .vrc-best-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 66px;
      line-height: 0.92;
      color: #f5f5f5;
      overflow-wrap: anywhere;
      margin-bottom: 12px;
    }
    .vrc-votes-badge {
      display: inline-flex;
      padding: 7px 14px;
      border-radius: 999px;
      background: rgba(255, 122, 26,0.10);
      border: 1px solid rgba(255, 122, 26,0.32);
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: #ffb36a;
      line-height: 1;
    }
    .vrc-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 26px;
    }
    .vrc-stat {
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 14px;
      background: rgba(255,255,255,0.03);
      padding: 13px 8px 12px;
      text-align: center;
    }
    .vrc-stat-value {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 34px;
      color: #f5f5f5;
      line-height: 1;
      margin-bottom: 6px;
    }
    .vrc-stat-label {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: rgba(178,184,194,0.55);
      line-height: 1;
    }
    .vrc-stat--accent .vrc-stat-value { color: #ff7a1a; }

    /* ── Seleção do ano ── */
    .vrc-selection { margin-bottom: 26px; }
    .vrc-field {
      position: relative;
      overflow: hidden;
      height: 560px;
      border-radius: 28px;
      border: 1px solid rgba(255, 122, 26,0.22);
      background:
        linear-gradient(180deg, rgba(30, 5, 9,0.10), rgba(0,0,0,0.24)),
        url("<%= selectionFieldUrl %>") center center / cover no-repeat;
      box-shadow:
        inset 0 0 0 1px rgba(255,255,255,0.035),
        inset 0 -80px 110px rgba(0,0,0,0.42);
    }
    .vrc-field::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at 50% 52%, rgba(255, 122, 26,0.10), transparent 34%),
        linear-gradient(180deg, rgba(0,0,0,0.14), transparent 24%, transparent 70%, rgba(0,0,0,0.32));
    }
    .vrc-field-row {
      position: absolute;
      left: 34px;
      right: 34px;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 96px;
      min-height: 112px;
    }
    .vrc-field-row--ATA { top: 42px; }
    .vrc-field-row--MEI { top: 188px; }
    .vrc-field-row--ZAG { top: 372px; }
    .vrc-field-row--GOL { top: 414px; min-height: 132px; }
    .vrc-field-player {
      width: 150px;
      min-height: 116px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      text-align: center;
      filter: drop-shadow(0 10px 18px rgba(0,0,0,0.36));
    }
    .vrc-field-row--ATA .vrc-field-player { transform: scale(0.92); }
    .vrc-field-row--ZAG .vrc-field-player,
    .vrc-field-row--GOL .vrc-field-player { transform: scale(1.03); }
    .vrc-field-photo {
      width: 82px;
      height: 82px;
      overflow: hidden;
      border-radius: 50%;
      border: 2px solid rgba(255, 122, 26,0.70);
      background: rgba(0,0,0,0.62);
      box-shadow: 0 8px 18px rgba(0,0,0,0.28);
    }
    .vrc-field-photo img { width: 100%; height: 100%; display: block; object-fit: cover; }
    .vrc-field-photo .vrc-photo-fallback { font-size: 24px; }
    .vrc-field-name {
      width: 100%;
      color: #f5f5f5;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.08;
      overflow-wrap: anywhere;
      text-shadow: 0 2px 8px rgba(0,0,0,0.88);
    }
    .vrc-field-score {
      color: rgba(255, 122, 26,0.82);
      font-size: 11px;
      font-weight: 900;
      line-height: 1;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    }

    /* ── Artilheiro, assistente e rei das fotos ── */
    .vrc-awards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 26px;
    }
    .vrc-award {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px 10px 15px;
      border-radius: 18px;
      border: 1px solid rgba(255, 122, 26,0.24);
      background: rgba(255, 122, 26,0.05);
    }
    .vrc-award-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: rgba(255,179,106,0.78);
      line-height: 1;
      margin-bottom: 12px;
    }
    .vrc-award-photo {
      width: 76px; height: 76px;
      border-radius: 50%;
      overflow: hidden;
      border: 2px solid rgba(255, 122, 26,0.70);
      background: #111;
      margin-bottom: 10px;
    }
    .vrc-award-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .vrc-award-photo .vrc-photo-fallback { font-size: 26px; }
    .vrc-award-name {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 25px;
      color: #f5f5f5;
      line-height: 1;
      letter-spacing: 0.02em;
      overflow-wrap: anywhere;
      margin-bottom: 8px;
    }
    .vrc-award-value {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 34px;
      color: #ff7a1a;
      line-height: 1;
      margin-bottom: 3px;
    }
    .vrc-award-unit {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: rgba(178,184,194,0.55);
      line-height: 1;
    }

    /* ── Footer ── */
    .vrc-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.06);
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      line-height: 1;
      color: rgba(178,184,194,0.26);
    }
  </style>
</head>
<body>
  <div class="vrc-card">
    <img class="vrc-watermark" src="<%= logoMarkUrl %>" alt="" />

    <div class="vrc-inner">
      <div class="vrc-branding">
        <img class="vrc-logo" src="<%= logoIconUrl %>" alt="" />
        <span class="vrc-brand-name"><%= safeBrand.name || "Horriver Plate" %></span>
      </div>

      <div class="vrc-title-row">
        <h1 class="vrc-title">Melhores<br>do Ano</h1>
        <div class="vrc-title-meta">
          <p class="vrc-title-meta-label">Votação dos jogadores</p>
          <p class="vrc-title-meta-name"><%= year %></p>
          <p class="vrc-title-meta-date"><%= voters %> <%= Number(voters) === 1 ? 'votante' : 'votantes' %></p>
        </div>
      </div>

      <div class="vrc-divider"></div>

      <div class="vrc-best">
        <div class="vrc-best-photo">
          <% if (hasPhoto(bestPlayer)) { %>
            <img src="<%= photoUrl(bestPlayer) %>" alt="" />
          <% } else { %>
            <div class="vrc-photo-fallback"><%= initialOf(bestPlayer) %></div>
          <% } %>
        </div>
        <div class="vrc-best-info">
          <p class="vrc-best-label">Melhor do ano</p>
          <p class="vrc-best-name"><%= displayName(bestPlayer) %></p>
          <span class="vrc-votes-badge"><%= votesLabel(bestPlayer.votes || 0) %></span>
        </div>
      </div>

      <div class="vrc-stats">
        <div class="vrc-stat">
          <div class="vrc-stat-value"><%= bestPlayer.matches ?? '–' %></div>
          <div class="vrc-stat-label">Jogos</div>
        </div>
        <div class="vrc-stat">
          <div class="vrc-stat-value"><%= bestPlayer.goals ?? '–' %></div>
          <div class="vrc-stat-label">Gols</div>
        </div>
        <div class="vrc-stat">
          <div class="vrc-stat-value"><%= bestPlayer.assists ?? '–' %></div>
          <div class="vrc-stat-label">Assist.</div>
        </div>
        <div class="vrc-stat vrc-stat--accent">
          <div class="vrc-stat-value"><%= bestPlayer.avgRating != null ? Number(bestPlayer.avgRating).toFixed(2) : '–' %></div>
          <div class="vrc-stat-label">Nota média</div>
        </div>
      </div>

      <div class="vrc-selection">
        <p class="vrc-section-label">Seleção do ano</p>
        <div class="vrc-field">
          <% selectionRows.forEach(function (row) { %>
            <div class="vrc-field-row vrc-field-row--<%= row.key %>">
              <% row.players.forEach(function (candidate) { %>
                <div class="vrc-field-player">
                  <div class="vrc-field-photo">
                    <% if (hasPhoto(candidate)) { %>
                      <img src="<%= photoUrl(candidate) %>" alt="" />
                    <% } else { %>
                      <div class="vrc-photo-fallback"><%= initialOf(candidate) %></div>
                    <% } %>
                  </div>
                  <span class="vrc-field-name"><%= displayName(candidate) %></span>
                  <span class="vrc-field-score"><%= votesLabel(candidate.votes || 0) %></span>
                </div>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </div>

      <% if (statAwards.length) { %>
        <div class="vrc-awards">
          <% statAwards.forEach(function (award) { %>
            <div class="vrc-award">
              <p class="vrc-award-label"><%= award.label %></p>
              <div class="vrc-award-photo">
                <% if (hasPhoto(award.player)) { %>
                  <img src="<%= photoUrl(award.player) %>" alt="" />
                <% } else { %>
                  <div class="vrc-photo-fallback"><%= initialOf(award.player) %></div>
                <% } %>
              </div>
              <p class="vrc-award-name"><%= displayName(award.player) %></p>
              <p class="vrc-award-value"><%= award.value %></p>
              <p class="vrc-award-unit"><%= award.unit %></p>
            </div>
          <% }); %>
        </div>
      <% } %>

      <div class="vrc-footer">
        <span><%= safeBrand.url || "horriverplate.onrender.com" %></span>
        <span>@_hpfrc</span>
      </div>
    </div>
  </div>
</body>
</html>
